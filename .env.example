# Copy this file to `.env` and fill in values. Never commit `.env`.
# On Vercel: Project Settings → Environment Variables (same names). Bot URL: https://<project>.vercel.app/api/messages

# --- Azure DevOps (Azure Boards) ---
# Organization name from https://dev.azure.com/<ADO_ORG> (omit if you use ADO_SERVER_URL below)
ADO_ORG=

# Project name (Boards live in this project)
ADO_PROJECT=

# Personal Access Token: Work Items (Read & write). Create at DevOps User settings > Personal access tokens
ADO_PAT=

# Optional: full base URL. Use for Azure DevOps Server, or leave empty to use https://dev.azure.com/<ADO_ORG>
# ADO_SERVER_URL=https://dev.azure.com/myorg

# Optional: work item type for `create task` command (default Task)
ADO_DEFAULT_WORK_ITEM_TYPE=Task

# Optional: max rows for `search` / `find` (default 20, capped at 50)
# ADO_SEARCH_TOP=20

# --- Microsoft Bot Framework (Azure Bot / Teams) ---
# From App Registration or Azure Bot "Configuration"
MicrosoftAppId=
MicrosoftAppPassword=

# Single-tenant app registration only: Azure Portal → App registrations → your bot app →
# "Directory (tenant) ID" (a GUID). NOT the subscription ID, NOT the tenant *name*.
# Set this on Vercel too (Project → Settings → Environment Variables). Without it, MSAL uses the
# "Bot Framework" tenant and you get AADSTS700016. Omit only for true multi-tenant bots.
# MicrosoftAppTenantId=
# (Azure templates sometimes use this name instead — either works:)
# MICROSOFT_APP_TENANT_ID=
# AZURE_TENANT_ID=

# --- Local HTTP server (ngrok forwards to this port) ---
PORT=3978
